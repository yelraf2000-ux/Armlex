# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://armlex:armlex@localhost:5433/armlex

# Providers actually used by the running system:
#   ANTHROPIC — answer generation (Sonnet) and query contextualisation (Haiku)
#   GEMINI    — query and corpus embeddings (gemini-embedding-2)
#   VOYAGE    — cross-encoder reranking (rerank-2.5)
# Without VOYAGE retrieval degrades to vector-only (87% -> 74% hit@5) and says
# so in the log; without GEMINI it falls back to FTS and warns loudly, because
# that scores ~0% on Russian questions.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=

# Benchmarked and rejected; kept so the comparison can be re-run.
OPENAI_API_KEY=
COHERE_API_KEY=

# Access control. Leave APP_PASSWORD empty for local development — the gate
# switches off entirely. In production the server REFUSES TO START without it:
# every answer spends real API credit, so an open URL is a bill anyone can run
# up. SESSION_SECRET signs the session cookie; changing it logs everyone out,
# which is how access is revoked.
APP_PASSWORD=
SESSION_SECRET=

# Scraper politeness
ARLIS_CRAWL_DELAY_MS=2000
ARLIS_USER_AGENT=ArmLexBot/0.1 (+legal research; contact rafayelarakelyan1@gmail.com)

# ── Google sign-in (optional) ────────────────────────────────────────────────
# Dormant until all three are set: the button does not render and the routes
# 404. Redirect URI to register in Google Cloud:
#   <PUBLIC_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_ORIGIN=https://armlex.onrender.com

# ── Subscriptions, via Lemon Squeezy (optional) ──────────────────────────────
# A Merchant of Record: they are the legal seller, collect and remit VAT, and
# pay out. No card or bank detail ever reaches this application, which is why
# Stripe — which does not cover Armenia — is not used here.
#
# Dormant until set. Webhook URL to register in Lemon Squeezy:
#   <PUBLIC_ORIGIN>/api/billing/webhook
# Subscribe it to: subscription_created, subscription_updated,
#                  subscription_cancelled, subscription_expired
LEMONSQUEEZY_STORE=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_FIRM=
LEMONSQUEEZY_WEBHOOK_SECRET=
