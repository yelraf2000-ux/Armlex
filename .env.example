# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://armlex:armlex@localhost:5433/armlex

# Providers actually used by the running system:
#   ANTHROPIC — answer generation (Sonnet) and query contextualisation (Haiku)
#   GEMINI    — query and corpus embeddings (gemini-embedding-2)
#   VOYAGE    — cross-encoder reranking (rerank-2.5)
# Without VOYAGE retrieval degrades to vector-only (87% -> 74% hit@5) and says
# so in the log; without GEMINI it falls back to FTS and warns loudly, because
# that scores ~0% on Russian questions.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=

# Benchmarked and rejected; kept so the comparison can be re-run.
OPENAI_API_KEY=
COHERE_API_KEY=

# Access control. Leave APP_PASSWORD empty for local development — the gate
# switches off entirely. In production the server REFUSES TO START without it:
# every answer spends real API credit, so an open URL is a bill anyone can run
# up. SESSION_SECRET signs the session cookie; changing it logs everyone out,
# which is how access is revoked.
APP_PASSWORD=
SESSION_SECRET=

# Scraper politeness
ARLIS_CRAWL_DELAY_MS=2000
ARLIS_USER_AGENT=ArmLexBot/0.1 (+legal research; contact rafayelarakelyan1@gmail.com)
