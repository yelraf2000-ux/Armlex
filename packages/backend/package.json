{
  "name": "@armlex/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "db:verify": "tsx src/db/verify.ts",
    "reembed": "tsx src/db/reembed.ts",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx src/ingest/run.ts",
    "test": "tsx --test src/**/*.test.ts",
    "crawl": "tsx src/crawl/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@armlex/scraper": "*",
    "@armlex/shared": "*",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.1.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.5"
  }
}
