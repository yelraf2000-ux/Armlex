node_modules/
dist/
*.tsbuildinfo
.env
.env.local

# Raw ARLIS HTML snapshots: large, regenerable, but kept locally so we can
# reparse without refetching. Do not commit.
data/snapshots/

# Embedding caches — 134 MB and 53 MB. Regenerable from the API, and the
# production system never reads them: the vectors it serves live in pgvector on
# Neon. These files exist so benchmarking can run without paying to re-embed.
data/vectors/
data/vectors-old/
*.jsonl.bak

# Triage answer dumps: the answer text PLUS the fragment text generation read,
# so a guard can be measured against the exact haystack the model saw. That
# makes them ~100 KB per question — 80 MB over the 250-question set. Local-only
# and regenerable for about $0.012 a question; the small metadata sibling
# (`triage-results.jsonl`) is the one that stays in git.
data/eval/*-answers.jsonl

# Conversation exports from eval/review.ts — real user questions and the
# answers they were given. Regenerable from the database at any time, and not
# something to commit: it is user content, not source.
armlex-conversations*.md
review*.md

# Golden-set backups taken before a proposer run (GOTCHAS: never run it without
# one). They are working safety copies for the length of a session; git history
# is the durable backup, so committing them would store the same content twice
# under a worse name.
data/eval/*.bak

# Triage samples used to measure something once. The conclusions live in
# CHANGELOG and BENCHMARK; the raw sample is regenerable at ~$0.012 a question.
data/eval/numbers-sample.jsonl

# Seeded design canvases: ~2.5 MB each because the editor is baked into every
# published page. The .dc.html artboards beside them are the source and ARE
# tracked — these are the build output, regenerated by the seeding helper.
design/*-directions.html
design/matyan-client-widget.html
design/armlex-workbench-directions.html

# Screenshots of the interface. Regenerable from design/shots.mjs against a
# running dev server, and 2.3 MB of binary that git would keep forever.
design/shots/

data/audit/*.json
data/audit/*.md
!data/audit/.gitkeep

.DS_Store

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# Harvested third-party forum content: internal evaluation only, never republished.
data/eval/accountant-am.jsonl
data/eval/triage-results*.jsonl
data/eval/threshold-scores.json
