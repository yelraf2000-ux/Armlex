node_modules/
dist/
*.tsbuildinfo
.env
.env.local

# Raw ARLIS HTML snapshots: large, regenerable, but kept locally so we can
# reparse without refetching. Do not commit.
data/snapshots/

# Embedding caches — 134 MB and 53 MB. Regenerable from the API, and the
# production system never reads them: the vectors it serves live in pgvector on
# Neon. These files exist so benchmarking can run without paying to re-embed.
data/vectors/
data/vectors-old/
*.jsonl.bak

# Triage answer dumps: the answer text PLUS the fragment text generation read,
# so a guard can be measured against the exact haystack the model saw. That
# makes them ~100 KB per question — 80 MB over the 250-question set. Local-only
# and regenerable for about $0.012 a question; the small metadata sibling
# (`triage-results.jsonl`) is the one that stays in git.
data/eval/*-answers.jsonl

data/audit/*.json
data/audit/*.md
!data/audit/.gitkeep

.DS_Store

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# Harvested third-party forum content: internal evaluation only, never republished.
data/eval/accountant-am.jsonl
data/eval/triage-results*.jsonl
data/eval/threshold-scores.json
