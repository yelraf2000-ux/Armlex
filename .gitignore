node_modules/
dist/
*.tsbuildinfo
.env
.env.local

# Raw ARLIS HTML snapshots: large, regenerable, but kept locally so we can
# reparse without refetching. Do not commit.
data/snapshots/

# Embedding caches — 134 MB and 53 MB. Regenerable from the API, and the
# production system never reads them: the vectors it serves live in pgvector on
# Neon. These files exist so benchmarking can run without paying to re-embed.
data/vectors/
data/vectors-old/
*.jsonl.bak
data/audit/*.json
data/audit/*.md
!data/audit/.gitkeep

.DS_Store

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# Harvested third-party forum content: internal evaluation only, never republished.
data/eval/accountant-am.jsonl
data/eval/triage-results*.jsonl
